// Exercises the shipped lib in src/image.wyn via the tests/image.wyn symlink.
import image

test "png format" { assert_eq(image.image_format("photo.png"), "png") }
test "jpg format" { assert_eq(image.image_format("a.jpg"), "jpg") }
test "jpeg maps to jpg" { assert_eq(image.image_format("a.jpeg"), "jpg") }
test "unknown format" { assert_eq(image.image_format("a.txt"), "unknown") }
test "buffer size" { assert_eq(image.image_buffer_size(2, 3, 4), 24) }
test "supported yes" { assert(image.image_is_supported("x.png")) }
test "supported no" { assert(not image.image_is_supported("x.txt")) }
test "dimensions str" { assert_eq(image.image_dimensions_str(800, 600), "800x600") }
